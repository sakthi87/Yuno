# Yugabyte Platform — runtime configuration (production template)
# Copy to /etc/yuno/yuno.env — secrets go in /etc/yuno/secrets.env

YUNO_COMPANY_NAME=Acme Corp
YUNO_CONFIG_PATH=/etc/yuno/yuno.env
YUNO_INSTALL_ROOT=/opt/yuno

# API binds localhost; nginx terminates TLS on 443
HOST=127.0.0.1
PORT=8080
COLLECTOR_URL=https://your-hostname.example.com/api/v1/ingest

DB_DRIVER=postgres
DATABASE_URL=postgresql://yuno:CHANGE_ME@127.0.0.1:5432/yuno_platform
AUTO_SEED=false
OFFLINE_INSTALL=true
STATIC_DIR=/opt/yuno/ui

TLS_ENABLED=true
TLS_CERT_PATH=/opt/yuno/tls/server.crt
TLS_KEY_PATH=/opt/yuno/tls/server.key

# secrets.env (chmod 600) — never commit
# AGENT_API_TOKEN=
# ADMIN_API_TOKEN=
# PGPASSWORD=

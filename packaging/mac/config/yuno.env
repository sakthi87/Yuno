# DB_DRIVER=sqlite
# Mac local development — no PostgreSQL required

YUNO_COMPANY_NAME=Local Dev (Mac)
YUNO_INSTALL_ROOT=
HOST=0.0.0.0
PORT=3001

DB_DRIVER=sqlite
DB_PATH=./data/platform.db
AUTO_SEED=true

# Vite dev server proxies /api → localhost:3001
STATIC_DIR=

# Optional — leave empty for local dev without ingest auth
# AGENT_API_TOKEN=dev-agent-token
# ADMIN_API_TOKEN=dev-admin-token

# Dependencies (install with npm run install:all)
node_modules/
**/node_modules/

# Local databases
*.db
*.db-wal
*.db-shm
backend/data/
*.sqlite

# Secrets — never commit
**/secrets.env
.env
.env.*
!.env.example

# Logs / OS / IDE
*.log
.DS_Store
.idea/
.vscode/
*.swp

# Generated packaging / offline bundles
packaging/dist/
packaging/*.tar.gz
packaging/*.sha256
yuno-install/bundle/

# Keep frontend production build (no Vite build required to run)
!frontend/dist/
!frontend/dist/**

# Runtime logs / compose state
logs/

# Extracted runtime / package workdirs (not source)
runtime/
dist-prebuilt/
dist-offline/

# Keep committed offline/*.tar.gz and offline/*.zip for air-gap copies
# (generated by package-prebuilt / copied into offline/)
!offline/
!offline/**

# Cursor / local tooling
.cursor/
agent-transcripts/
